				<text><![CDATA[No]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="30" y="0" width="65" height="24" forecolor="#FFFFFF" backcolor="#004D40"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[NIM]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="95" y="0" width="120" height="24" forecolor="#FFFFFF" backcolor="#004D40"/>
