	<pageFooter>
		<band height="24">
			<textField pattern="dd MMM yyyy HH:mm">
				<reportElement x="0" y="4" width="200" height="18"/>
				<textElement verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Dicetak: " + new java.text.SimpleDateFormat("dd-MM-yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="355" y="4" width="200" height="18"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8"/>
