				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[NIM]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="170" y="0" width="130" height="24" forecolor="#FFFFFF" backcolor="#004D40"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Peserta]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="300" y="0" width="80" height="24" forecolor="#FFFFFF" backcolor="#004D40"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Kelas]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="380" y="0" width="160" height="24" forecolor="#FFFFFF" backcolor="#004D40"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Kursus]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="540" y="0" width="85" height="24" forecolor="#FFFFFF" backcolor="#004D40"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Nominal]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="625" y="0" width="80" height="24" forecolor="#FFFFFF" backcolor="#004D40"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Metode]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="705" y="0" width="97" height="24" forecolor="#FFFFFF" backcolor="#004D40"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Status]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22">
			<textField>
				<reportElement x="0" y="0" width="40" height="22"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{id_pembayaran}]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy" isBlankWhenNull="true">
				<reportElement x="40" y="0" width="65" height="22"/>
				<box>
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{tanggal_bayar}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="105" y="0" width="65" height="22"/>
				<box leftPadding="3">
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="170" y="0" width="130" height="22"/>
				<box leftPadding="3">
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama_peserta}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="300" y="0" width="80" height="22"/>
				<box leftPadding="3">
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama_kelas}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="380" y="0" width="160" height="22"/>
				<box leftPadding="3">
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama_kursus}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true">
				<reportElement x="540" y="0" width="85" height="22"/>
				<box rightPadding="3">
					<pen lineWidth="0.5" lineColor="#000000"/>
				</box>
